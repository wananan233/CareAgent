{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carehub.local/contracts/alert-view.schema.json",
  "title": "AlertViewV1",
  "description": "模拟告警视图。S-1/S0 不可被前端取消；status 由服务端决定。",
  "type": "object",
  "additionalProperties": false,
  "required": ["alertId", "kind", "safetyLevel", "status", "occurredAt", "version"],
  "properties": {
    "alertId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["SMOKE_GAS", "SOS", "FALL", "GENERAL"] },
    "safetyLevel": { "enum": ["S-1", "S0", "S1", "S2"] },
    "status": { "enum": ["ACTIVE", "ACKNOWLEDGED", "RESOLVED"] },
    "occurredAt": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 }
  }
}
