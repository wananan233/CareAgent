{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carehub.local/contracts/care-event.schema.json",
  "title": "CareEventV1",
  "description": "合成 CareEvent。source.type 必须恒为 SIMULATOR，绝不可呈现为真实医疗事件。",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "occurredAt", "source", "quality", "sourceRefs"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": {
      "enum": ["MEDICATION_DUE", "SMOKE_GAS", "SOS", "FALL", "LOW_QUALITY_ACTIVITY"]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "simulatorId"],
      "properties": {
        "type": { "const": "SIMULATOR" },
        "simulatorId": { "type": "string", "minLength": 1 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["VALID", "LOW", "CONFLICT", "UNKNOWN"] },
        "reason": { "type": "string" }
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": { "$ref": "#/definitions/sourceRef" }
    }
  },
  "definitions": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refId", "kind", "label", "occurredAt"],
      "properties": {
        "refId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "occurredAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
