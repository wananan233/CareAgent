{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carehub.local/contracts/care-task.schema.json",
  "title": "CareTaskV1",
  "description": "任务与证据状态。evidenceState 不得出现“已吞服/已服药”语义。",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "kind", "status", "scheduledAt", "evidenceState", "version"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["MEDICATION", "SAFETY_CHECK", "ACTIVITY_REVIEW"] },
    "status": { "enum": ["DUE", "REMINDING", "ACKNOWLEDGED", "UNKNOWN"] },
    "scheduledAt": { "type": "string", "format": "date-time" },
    "evidenceState": { "enum": ["UNKNOWN", "SEEN", "PENDING"] },
    "version": { "type": "integer", "minimum": 1 }
  }
}
