{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carehub.local/contracts/agent-response.schema.json",
  "title": "AgentResponseV1",
  "description": "受控 Agent 响应。事实必须携带非空 sourceRefs；无来源内容不得成为事实卡片。",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "facts", "sourceRefs", "fallback"],
  "properties": {
    "message": { "type": "string" },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "sourceRefs", "confidence"],
        "properties": {
          "statement": { "type": "string", "minLength": 1 },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/sourceRef" }
          },
          "confidence": { "enum": ["VALID", "LOW", "CONFLICT", "UNKNOWN"] }
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": { "$ref": "#/definitions/sourceRef" }
    },
    "fallback": { "type": "boolean" },
    "reasonCode": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "fallback": { "const": true } } },
      "then": { "required": ["reasonCode"] }
    }
  ],
  "definitions": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refId", "kind", "label", "occurredAt"],
      "properties": {
        "refId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "occurredAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
