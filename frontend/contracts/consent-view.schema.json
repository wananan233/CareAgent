{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carehub.local/contracts/consent-view.schema.json",
  "title": "ConsentViewV1",
  "description": "同意授权视图。家属可见数据按 scope 裁剪；撤销后立即失效。",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "status", "expiresAt", "version"],
  "properties": {
    "scope": { "enum": ["timeline", "alerts", "tasks", "summary"] },
    "status": { "enum": ["GRANTED", "REVOKED", "EXPIRED", "PENDING"] },
    "expiresAt": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 }
  }
}
