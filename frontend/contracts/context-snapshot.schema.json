{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carehub.local/contracts/context-snapshot.schema.json",
  "title": "ContextSnapshotV1",
  "description": "最小化上下文快照。过期快照须显示更新时间，不得缓存敏感正文。",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotId", "purpose", "asOf", "facts", "unknowns", "freshness"],
  "properties": {
    "snapshotId": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "asOf": { "type": "string", "format": "date-time" },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value", "confidence"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "value": { "type": "string" },
          "confidence": { "enum": ["VALID", "LOW", "CONFLICT", "UNKNOWN"] }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "note"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "freshness": { "enum": ["FRESH", "STALE"] }
  }
}
