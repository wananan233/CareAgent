{
  "name": "carehub",
  "version": "0.1.0",
  "private": true,
  "description": "CareHub 2.0 — pure-software synthetic demo (elderly terminal + family mobile)",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @carehub/elder-terminal",
    "build": "npm run build --workspace @carehub/elder-terminal",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
