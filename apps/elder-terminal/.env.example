# CareHub 2.0 老人端 — 环境变量模板
#
# 说明：当前（E6）前端完全使用 MockCoreAdapter 返回合成数据，
# 以下变量为未来接入 C2 BFF / Core API 时预留，尚未接入任何业务逻辑。
# 复制为 .env 或 .env.local 使用（.env*.local 已在 .gitignore 中忽略）。

# Core API 基础路径（预留，未来 CoreApiAdapter 使用）
VITE_API_BASE_URL=/v1

# 演示模式：mock = 使用 MockCoreAdapter（当前唯一支持值）
VITE_DEMO_MODE=mock
