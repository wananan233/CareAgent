# CareHub 2.0 老人端 — 环境变量模板
#
# 说明：显式 mock 使用合成数据；配置三项 BFF 变量后接入真实受保护 BFF。
# 复制为 .env 或 .env.local 使用（.env*.local 已在 .gitignore 中忽略）。

# BFF 根地址（浏览器可达的反向代理地址）
VITE_CAREHUB_BFF_URL=http://127.0.0.1:8081
VITE_CAREHUB_TOKEN=replace-with-demo-token
VITE_CAREHUB_HOUSEHOLD_ID=household:synthetic-home

# 演示模式：mock = 使用 MockCoreAdapter；删除本行以使用 BFF 配置。
VITE_DEMO_MODE=mock
