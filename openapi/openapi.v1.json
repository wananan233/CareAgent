{
  "openapi": "3.1.0",
  "info": {"title": "CareHub BFF API", "version": "1.0.0-c2", "description": "模拟环境唯一 BFF 入口；所有资源读取均由 AuthContext 与 PDP 授权。"},
  "paths": {
    "/internal/v1/events:batch": {"post": {"summary": "受限内部事件接收入口", "responses": {"202": {"description": "accepted"}}}},
    "/internal/v1/model:generate": {"post": {"summary": "受限模型网关入口", "responses": {"200": {"description": "schema-constrained response"}}}},
    "/v1/users/{id}/chat": {"post": {"summary": "兼容聊天入口；生产双端应迁移至家庭/主体 BFF 路由", "responses": {"200": {"description": "AgentResponseV1"}}}},
    "/v1/me": {"get": {"responses": {"200": {"description": "当前身份及服务端解析的家庭"}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/v1/households": {"get": {"responses": {"200": {"description": "已授权家庭"}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/v1/households/{household_id}/subjects/{subject_id}/{view}": {"get": {"parameters": [{"$ref": "#/components/parameters/HouseholdId"}, {"$ref": "#/components/parameters/SubjectId"}, {"name": "view", "in": "path", "required": true, "schema": {"enum": ["tasks", "alerts", "timeline"]}}], "responses": {"200": {"description": "字段裁剪后的授权视图"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/v1/households/{household_id}/subjects/{subject_id}/stream": {"get": {"parameters": [{"$ref": "#/components/parameters/HouseholdId"}, {"$ref": "#/components/parameters/SubjectId"}, {"name": "Last-Event-ID", "in": "header", "schema": {"type": "integer", "minimum": 0}}], "responses": {"200": {"description": "授权 SSE view.updated / heartbeat 流", "content": {"text/event-stream": {"schema": {"type": "string"}}}}, "403": {"$ref": "#/components/responses/Error"}}}},
    "/v1/households/{household_id}/subjects/{subject_id}/requests": {"post": {"summary": "家属端受控命令入口", "parameters": [{"$ref": "#/components/parameters/HouseholdId"}, {"$ref": "#/components/parameters/SubjectId"}], "responses": {"200": {"description": "最小化命令回执或幂等状态"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}}},
    "/v1/consents": {"post": {"responses": {"201": {"description": "GRANTED consent"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}}},
    "/v1/consents/{consent_id}:activate": {"post": {"responses": {"200": {"description": "ACTIVE consent"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/v1/consents/{consent_id}:revoke": {"post": {"responses": {"200": {"description": "REVOKED consent"}, "409": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "parameters": {"HouseholdId": {"name": "household_id", "in": "path", "required": true, "schema": {"type": "string"}}, "SubjectId": {"name": "subject_id", "in": "path", "required": true, "schema": {"type": "string"}}},
    "responses": {"Error": {"description": "统一错误信封", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}},
    "schemas": {"ErrorEnvelope": {"type": "object", "required": ["code", "message", "retryable", "correlation_id"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "retryable": {"type": "boolean"}, "correlation_id": {"type": "string"}}}}
  }
}
