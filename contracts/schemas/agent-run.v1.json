{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carehub.local/contracts/AgentRunV1",
  "title": "AgentRunV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_run_id", "subject_id", "purpose", "trigger_event_ids", "channel", "status", "created_at", "updated_at", "correlation_id"],
  "properties": {
    "schema_version": {"const": "AgentRunV1"},
    "agent_run_id": {"type": "string", "minLength": 8},
    "subject_id": {"type": "string", "pattern": "^user:[a-zA-Z0-9_-]+$"},
    "purpose": {"type": "string", "enum": ["MEDICATION_REMINDER", "INACTIVITY_CHECK", "FALL_FOLLOW_UP", "DAILY_SUMMARY", "FAMILY_ESCALATION"]},
    "trigger_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "channel": {"type": "string", "enum": ["TERMINAL", "TTS", "FAMILY"]},
    "status": {"type": "string", "enum": ["RECEIVED", "CONTEXT_BUILDING", "CONTEXT_READY", "PLANNING", "PLAN_PROPOSED", "POLICY_CHECKING", "DENIED", "APPROVAL_REQUIRED", "WAITING_APPROVAL", "APPROVED", "EXPIRED", "REJECTED", "EXECUTING", "WAITING_RESULT", "RESPONDING", "COMPLETED", "CONTEXT_INVALID", "RETRYING", "DEGRADED", "ESCALATED", "FAILED"]},
    "context_snapshot_id": {"type": "string"},
    "plan_id": {"type": "string"},
    "reason_code": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 8}
  }
}
