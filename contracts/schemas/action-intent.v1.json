{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carehub.local/contracts/ActionIntentV1",
  "title": "ActionIntentV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent_id", "actor", "subject_id", "capability", "reason", "source_event_ids", "deadline", "idempotency_key"],
  "properties": {
    "schema_version": {"const": "ActionIntentV1"},
    "intent_id": {"type": "string", "minLength": 8},
    "actor": {"type": "string", "enum": ["RULE_ENGINE", "DETERMINISTIC_PLANNER", "POLICY_GATEWAY"]},
    "subject_id": {"type": "string", "pattern": "^user:[a-zA-Z0-9_-]+$"},
    "capability": {"type": "string", "enum": ["read_medication", "play_prompt", "request_safety_check", "notify_family"]},
    "reason": {"type": "string", "minLength": 1},
    "source_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "deadline": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 8},
    "args_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
