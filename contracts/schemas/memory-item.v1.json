{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carehub.local/contracts/MemoryItemV1",
  "title": "MemoryItemV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "memory_id", "type", "value", "source_event_ids", "consent_scope", "status", "owner", "valid_from", "expires_at"],
  "properties": {
    "schema_version": {"const": "MemoryItemV1"},
    "memory_id": {"type": "string", "minLength": 8},
    "type": {"type": "string", "enum": ["PREFERENCE", "HABIT", "ADDRESS_FORM"]},
    "value": {"type": "string", "minLength": 1},
    "source_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "consent_scope": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["CANDIDATE", "POLICY_ACCEPTED", "CONFIRMED", "ACTIVE", "REVOKED", "EXPIRED"]},
    "owner": {"type": "string", "pattern": "^user:[a-zA-Z0-9_-]+$"},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
