{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carehub.local/contracts/AgentResponseV1",
  "title": "AgentResponseV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "response_id", "agent_run_id", "channel", "message", "facts", "fallback", "generator_version"],
  "properties": {
    "schema_version": {"const": "AgentResponseV1"},
    "response_id": {"type": "string", "minLength": 8},
    "agent_run_id": {"type": "string", "minLength": 8},
    "channel": {"type": "string", "enum": ["TERMINAL", "TTS", "FAMILY"]},
    "message": {"type": "string", "minLength": 1, "maxLength": 280},
    "facts": {"type": "array", "items": {"type": "object", "required": ["text", "source_refs"], "properties": {"text": {"type": "string"}, "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "fallback": {"type": "string", "enum": ["NONE", "TEMPLATE_FALLBACK", "DETERMINISTIC_FALLBACK"]},
    "generator_version": {"type": "string", "minLength": 1}
  }
}
