{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carehub.local/contracts/ContextSnapshotV1",
  "title": "ContextSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "subject_id", "purpose", "as_of", "consent", "facts", "unknowns", "source_event_ids", "hash"],
  "properties": {
    "schema_version": {"const": "ContextSnapshotV1"},
    "snapshot_id": {"type": "string", "minLength": 8},
    "subject_id": {"type": "string", "pattern": "^user:[a-zA-Z0-9_-]+$"},
    "purpose": {"type": "string", "enum": ["CHAT", "MEDICATION_REMINDER", "INACTIVITY_CHECK", "DAILY_SUMMARY", "FAMILY_ESCALATION"]},
    "as_of": {"type": "string", "format": "date-time"},
    "consent": {"type": "object", "required": ["scopes", "expires_at"], "properties": {"scopes": {"type": "array", "items": {"type": "string"}}, "expires_at": {"type": "string", "format": "date-time"}}},
    "facts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["text", "source_refs"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 280}, "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "unknowns": {"type": "array", "items": {"type": "object", "required": ["field", "reason"], "properties": {"field": {"type": "string"}, "reason": {"type": "string"}}}},
    "source_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
