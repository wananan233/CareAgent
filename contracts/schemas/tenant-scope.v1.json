{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carehub.local/contracts/TenantScopeV1",
  "title": "TenantScopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "household_id", "subject_id", "principal_id", "role"],
  "properties": {
    "tenant_id": {"type": "string", "pattern": "^tenant:[a-zA-Z0-9_-]+$"},
    "household_id": {"type": "string", "pattern": "^household:[a-zA-Z0-9_-]+$"},
    "subject_id": {"type": "string", "pattern": "^user:[a-zA-Z0-9_-]+$"},
    "principal_id": {"type": "string", "pattern": "^(user|principal):[a-zA-Z0-9_-]+$"},
    "role": {"type": "string", "enum": ["SELF", "FAMILY", "CAREGIVER", "SYSTEM"]}
  }
}
